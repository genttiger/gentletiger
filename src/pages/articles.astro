---
import {sanityClient} from '../lib/sanity'

const articles = await sanityClient.fetch(`
  *[_type == "article"]{
    title,
    slug,
    excerpt,
    publishedAt
  }
`)
---

<html>
  <head>
    <title>Articles</title>
  </head>

  <body>
    <h1>Articles</h1>

    {
      articles.map((article) => (
        <article>
          <h2>{article.title}</h2>
          <p>{article.excerpt}</p>
          <small>{article.publishedAt}</small>
        </article>
      ))
    }

  </body>
</html>
