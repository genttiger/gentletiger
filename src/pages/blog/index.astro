---
import { client } from "../../lib/sanity";
import { urlFor } from "../../lib/image";


const posts = await client.fetch(`
  *[_type == "article"] | order(publishedAt desc){
    title,
    slug,
    excerpt,
    mainImage,
    publishedAt,
    category,
    author
  }
`);


const pageTitle =
  "Latest Articles | Luxury Bone China & Porcelain Guide";


const pageDescription =
  "Explore expert guides about bone china, luxury dinnerware, porcelain craftsmanship and elegant dining.";
---


<html>

<head>

<title>{pageTitle}</title>

<meta
name="description"
content={pageDescription}
/>


<link
rel="canonical"
href="https://genttiger.com/blog/"
/>


</head>


<body>


<main>


<h1>
Latest Articles
</h1>



{
posts.map((post:any)=>(


<article>


{
post.mainImage && (

<img
src={urlFor(post.mainImage).width(800).url()}
alt={post.title}
loading="lazy"
/>

)
}



<h2>

<a href={`/blog/${post.slug.current}`}>

{post.title}

</a>

</h2>



{
post.category && (

<p>
Category: {post.category}
</p>

)
}



{
post.author && (

<p>
Author: {post.author}
</p>

)

}



{
post.publishedAt && (

<p>

Published:

{
new Date(post.publishedAt)
.toLocaleDateString(
"en-US",
{
year:"numeric",
month:"long",
day:"numeric"
}
)

}

</p>

)

}



<p>

{post.excerpt}

</p>



<a href={`/blog/${post.slug.current}`}>

Read More 

</a>



</article>


))

}


</main>


</body>


</html>
